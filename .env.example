# PostgreSQL with pgvector enabled
DATABASE_URL=postgres://notebridge:notebridge@localhost:5432/notebridge

# Local stdio authentication. Replace for any shared environment.
NOTEBRIDGE_API_KEY=local-dev-key
NOTEBRIDGE_USER_ID=00000000-0000-4000-8000-000000000001

# Embedding provider: use "openai" for hosted embeddings or "local" for the
# offline semantic demo model. Local vectors are padded to the database's
# 1536-dimensional vector column.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Runtime
LOG_LEVEL=info
# Keep 127.0.0.1 locally. Use 0.0.0.0 inside a container or hosted runtime.
HOST=127.0.0.1
PORT=3000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
MAX_HTTP_BODY_BYTES=2000000
